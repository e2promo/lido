{
  "name": "lido-vk-ai-agent",
  "version": "1.0.0",
  "description": "Лидо — ИИ-агент для ВКонтакте, который доводит диалог до номера телефона",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test tests/*.test.js",
