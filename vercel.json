{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/app.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/app.js" },
    { "source": "/api", "destination": "/api/app.js" },
    { "source": "/webhook/vk", "destination": "/api/app.js" },
    { "source": "/vk/webhook", "destination": "/api/app.js" },
    { "source": "/health", "destination": "/api/app.js" }
  ]
}
